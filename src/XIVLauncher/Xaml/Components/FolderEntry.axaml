<UserControl x:Class="XIVLauncher.Xaml.Components.FolderEntry"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:XIVLauncher.Xaml.Components"
             x:DataType="components:FolderEntry">
    <DockPanel>
        <Button Margin="5,0,0,0" Padding="0" DockPanel.Dock="Right" Width="35" Height="28" Click="BrowseFolder">...</Button>
        <TextBox HorizontalAlignment="Stretch" DockPanel.Dock="Right"
                 Text="{Binding Text, Mode=TwoWay}" />
    </DockPanel>
</UserControl>
