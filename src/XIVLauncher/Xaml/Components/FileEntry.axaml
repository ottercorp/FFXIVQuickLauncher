<UserControl x:Class="XIVLauncher.Xaml.Components.FileEntry"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button Margin="5,0,0,0" Padding="0" DockPanel.Dock="Right" Width="35" Height="28" Click="BrowseFile">...</Button>
        <TextBox HorizontalAlignment="Stretch" DockPanel.Dock="Right"
                 Text="{Binding $parent[UserControl].Text, Mode=TwoWay}" />
    </DockPanel>
</UserControl>
