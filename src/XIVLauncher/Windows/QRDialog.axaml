<Window x:Class="XIVLauncher.Windows.QRDialog"
        x:Name="ScanQRWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialControls="using:Material.Styles.Controls"
        xmlns:viewModel="using:XIVLauncher.Windows.ViewModel"
        x:DataType="viewModel:QRDialogViewModel"
        Title="Scan QR Code"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Foreground="{DynamicResource MaterialDesignBody}"
        FontWeight="Medium"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Height="196.088"
        Width="269.186">
    <Grid Margin="0,0,0,0">
        <materialControls:Card Background="White" Height="165" Margin="0,0,10,0">
            <StackPanel Margin="16,8,10,0">
                <Image Height="99" Width="99" x:Name="QRImage" Focusable="True" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button
                        Content="{Binding OkLoc}"
                        Margin="7,0,0,0"
                        Width="220"
                        Height ="36"
                        Click="OkButton_OnClick" />
                </StackPanel>
                <TextBlock Foreground="DarkGray" Margin="0,8,0,0" TextAlignment="Center" Cursor="Hand" PointerReleased="OpenQRShortcutInfo_PointerReleased" Text="{Binding QRHintLoc}" />
            </StackPanel>
        </materialControls:Card>
    </Grid>
</Window>
